<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified">

    <!-- Elemento raíz -->
    <xs:element name="recursos">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="recurso" maxOccurs="unbounded">
                    <xs:complexType>
                        <xs:sequence>
                            <xs:element name="recurso_codigo" type="xs:string"/>
                            <xs:element name="recurso_nombre" type="xs:string"/>
                            <xs:element name="recurso_precio" type="xs:decimal"/>
                            <xs:element name="recurso_aula" type="xs:int"/>
                            <xs:element name="recurso_estado">
                                <xs:simpleType>
                                    <xs:restriction base="xs:int">
                                        <xs:minInclusive value="1"/>
                                        <xs:maxInclusive value="4"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                        </xs:sequence>
                    </xs:complexType>
                </xs:element>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

</xs:schema>